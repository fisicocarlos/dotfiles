{
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.wordWrapColumn": 80
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.wordWrapColumn": 80
  },
  "[latex]": {
    "editor.tabSize": 2
  },
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one",
    "editor.rulers": [
      80
    ],
    "editor.tabSize": 2,
    "editor.wordWrapColumn": 80
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.autopep8",
    "editor.detectIndentation": true,
    "editor.formatOnType": true,
    "editor.insertSpaces": true,
    "editor.rulers": [
      88,
      79
    ],
    "editor.tabSize": 4
  },
  "[scala]": {
    "editor.rulers": [
      120
    ],
    "editor.tabSize": 2
  },
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },
  "autoDocstring.docstringFormat": "google",
  "autoDocstring.guessTypes": true,
  "autopep8.args": [
    "--max-line-length=120"
  ],
  "docker.extension.enableComposeLanguageServer": false,
  "editor.folding": true,
  "editor.fontFamily": "SauceCodePro Nerd Font",
  "editor.fontSize": 13,
  "editor.glyphMargin": true,
  "editor.guides.indentation": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.insertSpaces": true,
  "editor.lineNumbers": "on",
  "editor.minimap.enabled": false,
  "editor.overviewRulerBorder": false,
  "editor.renderWhitespace": "selection",
  "editor.rulers": [
    80
  ],
  "editor.scrollbar.vertical": "auto",
  "editor.tabSize": 4,
  "explorer.confirmDelete": false,
  "explorer.copyRelativePathSeparator": "/",
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*": "${capture}.*",
    "*.py": "${capture}.pyc"
  },
  "files.autoSave": "afterDelay",
  "files.exclude": {
    "**.ruff_cache": true,
    "**/__pycache__": true,
    "**/.DS_Store": true,
    "**/.git": true,
    "**/.hg": true,
    "**/.idea": true,
    "**/.svn": true,
    "**/.venv": true,
    "**/.vscode": true,
    "**/CVS": true,
    "**/Thumbs.db": true
  },
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "files.watcherExclude": {
    "**/.ammonite": true,
    "**/.bloop": true,
    "**/.metals": true
  },
  "git-graph.commitDetailsView.fileView.type": "File List",
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.openRepositoryInParentFolders": "always",
  "git.suggestSmartCommit": false,
  "gitblame.statusBarMessageFormat": "${author.name} (${time.ago})",
  "http.proxySupport": "off",
  "indenticator.color.dark": "rgba(255,255,255,0.1)",
  "indenticator.width": 1,
  "java.configuration.maven.userSettings": "C:\\\\Users\\\\crs93731\\\\settings_maven.xml",
  "java.eclipse.downloadSources": true,
  "java.maven.downloadSources": true,
  "latex-workshop.bibtex-format.tab": "4 spaces",
  "latex-workshop.formatting.latex": "latexindent",
  "latex-workshop.latex.autoBuild.run": "never",
  "latex-workshop.latex.autoClean.run": "onSucceeded",
  "latex-workshop.latex.clean.subfolder.enabled": true,
  "latex-workshop.latex.outDir": "%DIR%",
  "python.testing.autoTestDiscoverOnSaveEnabled": true,
  "python.testing.unittestEnabled": true,
  "redhat.telemetry.enabled": false,
  "security.workspace.trust.untrustedFiles": "open",
  "settings.cycle": [
    {
      "id": "customLineNumbers",
      "overrideWorkspaceSettings": false,
      "values": [
        {
          "editor.lineNumbers": "relative"
        },
        {
          "editor.lineNumbers": "on"
        }
      ]
    }
  ],
  "shellformat.path": "/usr/bin/shfmt",
  "terminal.external.linuxExec": "Alacritty.app",
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.fontFamily": "SauceCodePro Nerd Font",
  "vsicons.associations.files": [
    {
      "extensions": [
        "properties"
      ],
      "format": "svg",
      "icon": "config"
    }
  ],
  "vsicons.dontShowNewVersionMessage": true,
  "window.commandCenter": false,
  "window.openFoldersInNewWindow": "on",
  "window.titleBarStyle": "custom",
  "workbench.colorCustomizations": {
    "editorRuler.foreground": "#333333",
    "statusBar.background": "#333333",
    "statusBar.foreground": "#ffffff9f"
  },
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.tabSizing": "shrink",
  "workbench.editorAssociations": {
    "*.pdf": "latex-workshop-pdf-hook"
  },
  "workbench.iconTheme": "material-icon-theme",
  "workbench.layoutControl.enabled": false,
  "workbench.list.openMode": "doubleClick",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.settings.applyToAllProfiles": [
    "editor.fontFamily"
  ],
  "workbench.sideBar.location": "right",
  "workbench.startupEditor": "none",
  "workbench.tree.indent": 20,
  "workbench.tree.renderIndentGuides": "none",
  "zenMode.centerLayout": false,
  "zenMode.hideLineNumbers": false,
  "zenMode.hideStatusBar": false
}
